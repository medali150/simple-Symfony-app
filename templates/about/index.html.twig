{% extends 'base.html.twig' %}

{% block title %}About Us{% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-8 offset-md-2">
        <h1 class="text-center mb-4">About Us</h1>
        
        <div class="card">
            <div class="card-body">
                <h2 class="card-title">Our Story</h2>
                <p class="card-text">
                    Welcome to our application! We are dedicated to providing a secure and user-friendly platform
                    for our users. Our mission is to make authentication and user management simple and efficient.
                </p>
                
                <h2 class="card-title mt-4">Our Features</h2>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Secure user authentication</li>
                    <li class="list-group-item">Easy registration process</li>
                    <li class="list-group-item">User-friendly interface</li>
                    <li class="list-group-item">Responsive design</li>
                </ul>
                
                <h2 class="card-title mt-4">Contact Us</h2>
                <p class="card-text">
                    If you have any questions or need assistance, please don't hesitate to reach out to us.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %} 